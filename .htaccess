# Direcciones limpias, sin .html a la vista.
#
# Solo hace falta en hosting Apache (el clásico de FTP: cPanel, Plesk, la
# mayoría de los compartidos españoles). La web está en Vercel, y allí manda
# vercel.json; esto queda por si algún día se muda a un compartido.

Options -MultiViews
RewriteEngine On

# 0. Direcciones antiguas, antes de que las páginas tuvieran nombre de buscador.
RewriteRule ^servicios/?$ /diseno-web [R=301,L]
RewriteRule ^portfolio/?$ /trabajos [R=301,L]
RewriteRule ^metodo/?$ /como-trabajo [R=301,L]
RewriteRule ^estudio/?$ /sobre-mi [R=301,L]
RewriteRule ^contacto/?$ /presupuesto [R=301,L]

# 1. Si alguien entra con .html, se le manda a la dirección limpia (301).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Y por dentro se sirve el archivo .html que corresponde.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# Compresión y caché, que no cuesta nada.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>
# Los .woff2 no: ya vienen comprimidos y volver a apretarlos solo gasta CPU.

# Nada se guarda sin preguntar: el navegador conserva la copia, pero revalida
# siempre y el servidor contesta 304 si no ha cambiado. Los archivos de este
# sitio no llevan versión en el nombre, así que una caché larga significa servir
# lo viejo tras publicar. Ya pasó dos veces con estilos.css. Mismo criterio que
# en vercel.json, que es lo que manda hoy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  # Cabeceras de seguridad. Las mismas tres que pone vercel.json, y por el mismo
  # motivo: no cambian nada visible y son lo primero que mira cualquier revisión.
  # nosniff impide que el navegador adivine el tipo de un archivo y lo ejecute
  # como si fuera otra cosa; Referrer-Policy deja de mandar la dirección
  # completa de la página a los servicios de capturas, que solo necesitan saber
  # el dominio; Permissions-Policy apaga cámara, micrófono, ubicación, pagos y
  # USB, que esta web no usa y así no puede usarlos nada incrustado.
  # No hay Content-Security-Policy a proposito: habria que listar Analytics y
  # los tres servicios de capturas, y olvidar uno deja el portfolio en blanco.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  <FilesMatch "\.(css|js|svg|png|ico|webp)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Las fuentes son la excepción, y por eso llevan la versión en el nombre
  # (archivo-v25, bricolage-v9): actualizar una es subir un archivo nuevo, así
  # que guardarlas un año no puede servir nada viejo.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
